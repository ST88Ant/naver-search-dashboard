# ─────────────────────────────────────────────────────────────
# NAVER API HUB 인증 정보 (네이버 클라우드 플랫폼)
# 발급: https://www.ncloud.com/product/applicationService/naverApiHub
#
# 이 파일을 복사해서 `.env` 로 저장하고 값을 채워 넣으세요.
#   cp .env.example .env
# `.env` 는 git 에 커밋되지 않습니다(.gitignore 등록됨).
# ─────────────────────────────────────────────────────────────

# 콘솔에서 발급받은 API Key ID (X-NCP-APIGW-API-KEY-ID 헤더로 전송)
NAVER_API_KEY_ID=your-api-key-id-here

# 콘솔에서 발급받은 API Key (X-NCP-APIGW-API-KEY 헤더로 전송)
NAVER_API_KEY=your-api-key-here

# (선택) API Gateway base URL - 특별한 경우가 아니면 수정하지 마세요.
# NAVER_API_BASE_URL=https://naverapihub.apigw.ntruss.com
